# Copy to .env (never commit .env). See README §8.
# Naver Search API (NAVER API HUB) — collect_windows.py, collect_fullperiod.py
NAVER_CLIENT_ID=YOUR_CLIENT_ID
NAVER_CLIENT_SECRET=YOUR_CLIENT_SECRET
# Translation — translate_abstracts.py. Fill in the one provider the team chose.
DEEPL_API_KEY=YOUR_DEEPL_KEY
# DEEPL_ENDPOINT=https://api.deepl.com/v2/translate      # paid plan; the default is the free endpoint
PAPAGO_CLIENT_ID=YOUR_PAPAGO_ID
PAPAGO_CLIENT_SECRET=YOUR_PAPAGO_SECRET
